[Unit]
Description=Ant Colony Gateway - Enterprise Multi-Agent Collaboration System
After=network.target

[Service]
Type=simple
User=codexcheck
WorkingDirectory=/home/codexcheck/ant-colony-probe
ExecStart=/usr/bin/python3 -c "from src.gateway.webhook_server import serve; serve('0.0.0.0', 18090, 'server-deepseek')"
Restart=always
RestartSec=5
StandardOutput=append:/home/codexcheck/ant-colony-probe/gateway.log
StandardError=append:/home/codexcheck/ant-colony-probe/gateway.log

[Install]
WantedBy=multi-user.target
